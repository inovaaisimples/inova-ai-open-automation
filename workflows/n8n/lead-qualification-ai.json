    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst required = ['nome','email','interesse','mensagem'];\nconst missing = required.filter((key) => typeof body[key] !== 'string' || !body[key].trim());\nif (missing.length) return [{json:{statusCode:400,error:`Campos obrigatórios ausentes: ${missing.join(', ')}`}}];\nconst interest=body.interesse.toLowerCase();\nconst priority=/(automação|automacao|crm|\\bia\\b)/.test(interest)?'alta':'normal';\nreturn [{json:{statusCode:200,status:'qualificado',prioridade:priority,categoria:body.interesse.trim().slice(0,80),proxima_acao:priority==='alta'?'Contato comercial prioritário':'Adicionar à fila de qualificação'}}];"
      },
      "id": "b9d2c881-0e11-4e1a-ae60-000000000002",
